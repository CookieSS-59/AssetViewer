<Window x:Class="AssetViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asset Viewer" Height="900" Width="1500" MinHeight="650" MinWidth="1050"
        Background="#0D1117" Foreground="#E9EEF5" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#171D26"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#111720"/>
    <SolidColorBrush x:Key="Muted" Color="#B8C4D3"/>
    <SolidColorBrush x:Key="Accent" Color="#7CE0C8"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E9EEF5"/>
      <Setter Property="Background" Value="#252E3A"/>
      <Setter Property="BorderBrush" Value="#394555"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#313D4C"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#546477"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#10161F"/><Setter Property="Foreground" Value="#E9EEF5"/>
      <Setter Property="BorderBrush" Value="#354151"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="#7CE0C8"/><Setter Property="Padding" Value="11,9"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E9EEF5"/><Setter Property="Background" Value="#202833"/>
      <Setter Property="BorderBrush" Value="#394555"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,9">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,22,0"/><Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#D5DEEA" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#202833" BorderBrush="#3A4655" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
              <ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#202833"/><Setter Property="Foreground" Value="#E9EEF5"/><Setter Property="Padding" Value="11,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2A554F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="#D8DFE8"/>
      <Setter Property="Padding" Value="2,2"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
        <StackPanel>
          <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="4,2">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ToggleButton x:Name="Expander" Grid.Column="0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="False" Width="18" Height="22" Background="Transparent" BorderThickness="0" Foreground="#D2DCE8" FontSize="13" Content="›"/>
              <ContentPresenter Grid.Column="1" x:Name="HeaderHost" ContentSource="Header" HorizontalAlignment="Stretch"/>
            </Grid>
          </Border>
          <ItemsPresenter x:Name="ItemsHost" Margin="16,1,0,0"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#263B3A"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#202A35"/></Trigger>
          <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expander" Property="Content" Value="⌄"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="ASSET / VIEWER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="Your files, ready to inspect" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel Margin="0,0,10,0"><TextBlock Text="SEARCH CURRENT FOLDER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="2,0,0,4"/><DockPanel><TextBox x:Name="SearchBox" Width="180" VerticalContentAlignment="Center" ToolTip="Search in the highlighted folder, or in the root" TextChanged="SearchBox_TextChanged"/><Button Content="Clear" Click="ClearSearch_Click" Margin="6,0,0,0" Padding="10,8" Background="#26313E" BorderBrush="#465669"/></DockPanel></StackPanel>
        <StackPanel Margin="0,0,10,0"><TextBlock Text="FILE TYPE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="2,0,0,4"/><ComboBox x:Name="TypeFilter" Width="145" SelectionChanged="TypeFilter_SelectionChanged" SelectedIndex="0"><ComboBoxItem Content="All files"/><ComboBoxItem Content="Images"/><ComboBoxItem Content="Audio"/><ComboBoxItem Content="Video"/><ComboBoxItem Content="3D models"/><ComboBoxItem Content="Scripts"/></ComboBox></StackPanel>
        <StackPanel><TextBlock Text=" " FontSize="9" Margin="2,0,0,4"/><Button Content="📂   Open folder" Click="OpenFolder_Click" Background="#267B69" BorderBrush="#3B9E88" Padding="17,10"/></StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="13" BorderBrush="#293341" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,15,16,10">
            <DockPanel><TextBlock Text="FOLDER TREE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="TreeCount" Text="0 files" Foreground="#B0BDCC" FontSize="11" DockPanel.Dock="Right"/></DockPanel>
            <TextBlock x:Name="FolderLabel" Text="Choose a folder to browse" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Text, ElementName=FolderLabel}"/>
            <Border Height="1" Background="#293341" Margin="0,13,0,0"/>
          </StackPanel>
          <TreeView x:Name="AssetTree" Margin="9,0,9,10" Background="Transparent" BorderThickness="0" SelectedItemChanged="AssetTree_SelectedItemChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <DockPanel Margin="5,8" LastChildFill="True">
                <TextBlock Text="{Binding Icon}" Width="23" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#F1F5FA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Details}" Margin="9,0,5,0" FontSize="11" Foreground="#BAC6D4" VerticalAlignment="Center"/>
              </DockPanel>
            </HierarchicalDataTemplate></TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="13" BorderBrush="#293341" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="18,15,18,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="PreviewTitle" Text="Preview" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="PreviewSubTitle" Text="Select a file in the folder tree" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="FormatBadge" Text="READY" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="RevealButton" Content="📍   View file location" Click="Reveal_Click" IsEnabled="False" Background="#273544" BorderBrush="#425569" Padding="13,9"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="14,0,14,14" ClipToBounds="True">
            <Border Background="#0D1219" CornerRadius="10"/>
            <Grid x:Name="EmptyState">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="◇" FontSize="48" Foreground="#465668" HorizontalAlignment="Center"/>
                <TextBlock Text="Open a folder to explore its contents" FontSize="16" Foreground="#B4BFCD" HorizontalAlignment="Center" Margin="0,12,0,5"/>
                <TextBlock Text="Images · GIFs · audio · 3D models · scripts" FontSize="12" Foreground="#788697" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <Grid x:Name="ImageSurface" Visibility="Collapsed">
              <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid Background="#0D1219"><Image x:Name="ImagePreview" Stretch="Uniform" MaxWidth="1400" MaxHeight="820"/></Grid></ScrollViewer>
              <Border x:Name="GifControls" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" Padding="12,9" Background="#F01A222D" BorderBrush="#556576" BorderThickness="1" CornerRadius="11">
                <DockPanel LastChildFill="True">
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="GifPlayButton" Content="Ⅱ  Pause" Click="GifPlay_Click" Padding="12,8" Background="#2C655C" BorderBrush="#4C9A89"/>
                    <Button Content="↺  Restart" Click="GifRestart_Click" Margin="7,0,12,0" Padding="12,8"/>
                    <TextBlock x:Name="GifFrameLabel" Text="Frame 1 / 1" Foreground="#F3F6FA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  </StackPanel>
                  <Slider x:Name="GifSlider" Width="180" Minimum="0" Maximum="0" VerticalAlignment="Center" ValueChanged="GifSlider_ValueChanged" PreviewMouseDown="GifSlider_PreviewMouseDown" PreviewMouseUp="GifSlider_PreviewMouseUp"/>
                  <ComboBox x:Name="GifSpeed" Width="90" SelectedIndex="1" SelectionChanged="GifSpeed_SelectionChanged" Margin="12,0,0,0" VerticalAlignment="Center"><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/></ComboBox>
                </DockPanel>
              </Border>
            </Grid>
            <Grid x:Name="AudioSurface" Visibility="Collapsed">
              <Border Width="520" Padding="28" Background="#151E29" BorderBrush="#334355" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="AUDIO PREVIEW" FontSize="11" FontWeight="Bold" Foreground="#A8B9C9" HorizontalAlignment="Center"/>
                  <TextBlock Text="♫" FontSize="76" Foreground="#7CE0C8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                  <TextBlock x:Name="AudioName" Text="Audio file" FontSize="21" FontWeight="SemiBold" Foreground="#F4F7FB" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                  <TextBlock x:Name="AudioFormat" Text="Audio preview" FontSize="13" Foreground="#B5C2D0" HorizontalAlignment="Center"/>
                  <Slider x:Name="AudioSlider" Margin="0,25,0,8" Minimum="0" Maximum="100" ValueChanged="AudioSlider_ValueChanged" PreviewMouseDown="AudioSlider_PreviewMouseDown" PreviewMouseUp="AudioSlider_PreviewMouseUp"/>
                  <DockPanel><TextBlock x:Name="AudioTime" Text="00:00 / 00:00" Foreground="#CBD5E1" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PlayButton" Content="▶   Play" Click="Play_Click" Margin="4,0" Background="#286C5F" BorderBrush="#479987"/><Button Content="■   Stop" Click="Stop_Click" Margin="4,0"/></StackPanel></DockPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,0"><TextBlock Text="VOLUME" FontSize="10" FontWeight="Bold" Foreground="#B5C2D0" VerticalAlignment="Center" Margin="0,0,10,0"/><Slider x:Name="AudioVolumeSlider" Width="170" Minimum="0" Maximum="1" Value="1" ValueChanged="AudioVolumeSlider_ValueChanged"/></StackPanel>
                  <TextBlock x:Name="AudioStatus" Text="Ready to play" Foreground="#A8B9C9" FontSize="12" TextAlignment="Center" Margin="0,16,0,4"/>
                  <Button x:Name="ExternalAudioButton" Content="Open in external player" Click="OpenExternalAudio_Click" Visibility="Collapsed" HorizontalAlignment="Center" Background="#334255"/>
                </StackPanel>
              </Border>
              <MediaElement x:Name="AudioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Hidden" MediaOpened="AudioPlayer_MediaOpened" MediaEnded="AudioPlayer_MediaEnded"/>
            </Grid>
            <Grid x:Name="VideoSurface" Visibility="Collapsed" Background="#080B10">
              <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded" MediaFailed="VideoPlayer_MediaFailed"/>
              <Border VerticalAlignment="Bottom" Margin="16" Padding="13" Background="#F01A222D" BorderBrush="#556576" BorderThickness="1" CornerRadius="11">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Slider x:Name="VideoSlider" Minimum="0" Maximum="100" ValueChanged="VideoSlider_ValueChanged" PreviewMouseDown="VideoSlider_PreviewMouseDown" PreviewMouseUp="VideoSlider_PreviewMouseUp"/>
                  <DockPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock x:Name="VideoTime" Text="00:00 / 00:00" Foreground="#E8EEF5" VerticalAlignment="Center"/><TextBlock x:Name="VideoStatus" Text="Ready" Foreground="#B3BFCC" VerticalAlignment="Center" Margin="12,0,0,0"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="VideoPlayButton" Content="▶  Play" Click="VideoPlay_Click" Background="#286C5F" BorderBrush="#479987"/><Button Content="↺  Restart" Click="VideoRestart_Click" Margin="7,0,0,0"/><Button x:Name="ExternalVideoButton" Content="Open externally" Click="OpenExternalVideo_Click" Margin="7,0,0,0" Visibility="Collapsed"/></StackPanel></DockPanel>
                </Grid>
              </Border>
            </Grid>
            <Grid x:Name="ModelSurface" Visibility="Collapsed">
              <Viewport3D x:Name="ModelViewport" ClipToBounds="True" MouseDown="ModelViewport_MouseDown" MouseMove="ModelViewport_MouseMove" MouseUp="ModelViewport_MouseUp" MouseWheel="ModelViewport_MouseWheel"/>
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13" Padding="10,7" Background="#D0202833" CornerRadius="7"><TextBlock Text="Drag to rotate  ·  Scroll to zoom" FontSize="11" Foreground="#D8E1EB"/></Border>
              <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="13" Padding="10,7" Background="#D0202833" CornerRadius="7"><TextBlock x:Name="ModelStats" Text="" FontSize="11" Foreground="#D8E1EB"/></Border>
            </Grid>
            <Grid x:Name="TextSurface" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBox x:Name="TextPreview" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" BorderThickness="0" Padding="18"/>
              <DockPanel Grid.Row="1" Margin="18,0,18,12"><TextBlock x:Name="LineCount" Foreground="#7B8898" FontSize="11"/><TextBlock x:Name="EncodingLabel" Text="TEXT" DockPanel.Dock="Right" Foreground="#7B8898" FontSize="11"/></DockPanel>
            </Grid>
            <Grid x:Name="UnsupportedSurface" Visibility="Collapsed">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="▧" FontSize="46" Foreground="#59697B" HorizontalAlignment="Center"/>
                <TextBlock Text="This file is listed but has no preview yet" FontSize="15" Foreground="#B4BFCD" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="UnsupportedText" Foreground="#8390A0" HorizontalAlignment="Center" Margin="0,7,0,0"/>
              </StackPanel>
            </Grid>
          </Grid>
          <DockPanel Grid.Row="2" Margin="18,0,18,14">
            <TextBlock x:Name="StatusText" Text="0 files" Foreground="#CBD5E1" FontSize="12"/>
            <TextBlock Text="LOCAL FILES · NO UPLOADS" DockPanel.Dock="Right" Foreground="#AAB7C7" FontSize="10"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="4" Text="ASSET VIEWER     /     WINDOWS DESKTOP" Foreground="#566273" FontSize="10"/>
  </Grid>
</Window>
